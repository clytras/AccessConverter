*.accdb
*.mdb
# except the small Access-authored fixtures the tests need (tier D)
!/src/test/resources/fixtures/**/*.mdb
!/src/test/resources/fixtures/**/*.accdb
*.zip
*.sql
# except the golden files the target tests compare against
!/src/test/resources/golden/**/*.sql
*.sqlite3
.idea/
.settings/
# Build output at the repository root only: unanchored, these would also hide source packages named
# build/ or target/ (src/main/java/.../target/ is the target-writer package)
/dist/
/build/
/target/
/target-ide/
/releases/
/test/
samples/
/*.jar
/*.json
/docs/plans/

# IDE metadata: IDEs import pom.xml, nothing IDE-specific is committed
.classpath
.project
.factorypath
nbproject/
nb-configuration.xml
*.iml
