{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "convert",
            "request": "launch",
            "mainClass": "io.lytrax.accessconverter.cli.Main",
            "projectName": "accessconverter",
            "args": "convert samples/Northwind-2007.accdb --to sqlite -o target/run/Northwind-2007.sqlite3 --overwrite --verify"
            // "args": "convert samples/allTypes.accdb --to json -o target/run/allTypes.json --overwrite --binary files --ole-extract"
            // "args": "convert samples/Northwind-2007.accdb --to mysql -o target/run/Northwind-2007.sql --overwrite"
        },
        {
            "type": "java",
            "name": "inspect",
            "request": "launch",
            "mainClass": "io.lytrax.accessconverter.cli.Main",
            "projectName": "accessconverter",
            "args": "inspect samples/Northwind-2007.accdb --profile"
        },
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        }
    ]
}
