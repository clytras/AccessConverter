{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/clytras/AccessConverter/master/src/main/resources/io/lytrax/accessconverter/target/json/accessconverter-json-v1.schema.json",
  "title": "AccessConverter JSON export, format version 1",
  "description": "A Microsoft Access database exported by AccessConverter: the whole schema and every value. Validates the document layout (one .json file) and the ndjson layout's schema.json; each line of a <table>.ndjson file is a #/$defs/objectRow or #/$defs/arrayRow, as encoding.rows says.",
  "type": "object",
  "required": ["format", "formatVersion", "producer", "layout", "encoding", "source"],
  "properties": {
    "format": { "const": "accessconverter" },
    "formatVersion": { "const": 1 },
    "producer": { "type": "string", "description": "The tool and its version." },
    "layout": { "enum": ["document", "ndjson"] },
    "encoding": { "$ref": "#/$defs/encoding" },
    "source": { "$ref": "#/$defs/source" },
    "schema": { "$ref": "#/$defs/schema" },
    "data": {
      "type": "object",
      "description": "Each written table's rows, keyed by the table's name, in the order of schema.tables. Always the last property, so a streaming reader has seen the schema first.",
      "additionalProperties": { "type": "array" }
    },
    "files": {
      "type": "object",
      "description": "ndjson layout: each written table's file in the same directory.",
      "additionalProperties": { "type": "string", "pattern": "\\.ndjson$" }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "layout": { "const": "document" } } },
      "then": { "required": ["data"], "not": { "required": ["files"] } }
    },
    {
      "if": { "properties": { "layout": { "const": "ndjson" } } },
      "then": { "required": ["files"], "not": { "required": ["data"] } }
    },
    {
      "if": { "properties": { "encoding": { "properties": { "rows": { "const": "object" } } } } },
      "then": { "properties": { "data": { "additionalProperties": { "items": { "$ref": "#/$defs/objectRow" } } } } }
    },
    {
      "if": { "properties": { "encoding": { "properties": { "rows": { "const": "array" } } } } },
      "then": { "properties": { "data": { "additionalProperties": { "items": { "$ref": "#/$defs/arrayRow" } } } } }
    }
  ],
  "$defs": {
    "encoding": {
      "type": "object",
      "description": "How values are spelled in this file.",
      "required": ["rows", "bigint", "decimals", "hyperlinks", "binary", "ole"],
      "properties": {
        "rows": { "enum": ["object", "array"], "description": "object: {\"column\": value, …}; array: [value, …] in schema column order." },
        "bigint": { "enum": ["number", "string"], "description": "Large Number (int64) values." },
        "decimals": { "enum": ["number", "string"], "description": "Currency and Decimal values, always exact and never in exponent form." },
        "hyperlinks": { "enum": ["string", "object"], "description": "string: display#address#subaddress#screentip as Access stores it; object: #/$defs/hyperlink." },
        "binary": { "enum": ["base64", "files", "omit"], "description": "Binary, OLE and attachment bytes (--binary). base64: standard base64 (RFC 4648, padded, no line breaks); files: #/$defs/binaryFile, a file under <output>-files/; omit: #/$defs/binarySize, the byte count only." },
        "ole": { "enum": ["raw", "extracted"], "description": "OLE values (--ole-extract). raw: the stored bytes, spelled as encoding.binary says; extracted: #/$defs/oleObject." }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["file", "fileFormat", "charset"],
      "properties": {
        "file": { "type": "string" },
        "fileFormat": { "type": "string", "description": "Jackcess's name for the file format, such as V1997 or V2010." },
        "codePage": { "type": "integer", "description": "Access 97 only: the code page in the file's header." },
        "charset": { "type": "string", "description": "The charset text was decoded with (UTF-16LE from Access 2000 on)." },
        "exported": { "type": "string", "format": "date-time", "description": "Only with --stamp: when the export ran (UTC)." }
      },
      "additionalProperties": false
    },
    "schema": {
      "type": "object",
      "required": ["tables", "linkedTables", "relationships"],
      "properties": {
        "tables": { "type": "array", "items": { "$ref": "#/$defs/table" } },
        "linkedTables": { "type": "array", "items": { "$ref": "#/$defs/linkedTable" } },
        "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } }
      },
      "additionalProperties": false
    },
    "table": {
      "type": "object",
      "required": ["name", "description", "columns", "primaryKey", "indexes", "validationRule"],
      "properties": {
        "name": { "type": "string" },
        "linkedFrom": {
          "type": "object",
          "description": "Only for a linked table read from its back-end (--linked resolve, since 3.2): where Access says its data lives. name is the table's name in this database.",
          "required": ["database", "remoteTable"],
          "properties": {
            "database": { "type": "string", "description": "The back-end's path as Access stored it." },
            "remoteTable": { "type": "string", "description": "The table's name in the back-end." }
          },
          "additionalProperties": false
        },
        "description": { "type": ["string", "null"] },
        "columns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/column" } },
        "primaryKey": { "oneOf": [{ "$ref": "#/$defs/index" }, { "type": "null" }] },
        "indexes": { "type": "array", "items": { "$ref": "#/$defs/index" } },
        "validationRule": { "oneOf": [{ "$ref": "#/$defs/validationRule" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "column": {
      "type": "object",
      "required": ["name", "type", "accessType", "nullable", "required"],
      "properties": {
        "name": { "type": "string" },
        "type": {
          "enum": ["boolean", "uint8", "int16", "int32", "int64", "decimal", "float32", "float64", "datetime", "string", "hyperlink", "guid", "binary", "ole", "attachments", "multiValue", "versionHistory", "complexId"],
          "description": "How the column's values are spelled; see the format documentation."
        },
        "accessType": {
          "enum": ["BOOLEAN", "BYTE", "INT", "LONG", "BIG_INT", "MONEY", "FLOAT", "DOUBLE", "NUMERIC", "SHORT_DATE_TIME", "EXT_DATE_TIME", "TEXT", "MEMO", "HYPERLINK", "GUID", "BINARY", "OLE", "ATTACHMENT", "MULTI_VALUE", "VERSION_HISTORY", "COMPLEX_UNSUPPORTED", "UNSUPPORTED"]
        },
        "nullable": { "type": "boolean", "description": "false only where every value is non-null: Access guarantees it, or requires it and the data holds no NULL." },
        "required": { "type": "boolean", "description": "Access's Required property, as Access has it." },
        "autoNumber": { "enum": ["increment", "random", "guid"], "description": "An AutoNumber: a Long Integer whose New Values are Increment or Random (Access stores Random as the default GenUniqueID(), which is then not listed as a default), or a Replication ID." },
        "length": { "type": "integer", "minimum": 0, "description": "Characters for text, bytes for binary." },
        "precision": { "type": "integer", "minimum": 1 },
        "scale": { "type": "integer", "minimum": 0 },
        "allowZeroLength": { "type": "boolean" },
        "default": { "$ref": "#/$defs/default" },
        "validationRule": { "$ref": "#/$defs/validationRule" },
        "description": { "type": "string" },
        "format": { "type": "string" },
        "decimalPlaces": { "type": "integer" },
        "richText": { "const": true },
        "calculatedExpression": { "type": "string" },
        "appendOnly": { "const": true },
        "hidden": { "const": true },
        "element": {
          "type": "object",
          "description": "multiValue only: the type of each value in the array.",
          "required": ["type", "accessType"],
          "properties": {
            "type": { "enum": ["boolean", "uint8", "int16", "int32", "int64", "decimal", "float32", "float64", "datetime", "string", "guid", "binary"] },
            "accessType": { "type": "string" },
            "length": { "type": "integer", "minimum": 0 },
            "precision": { "type": "integer", "minimum": 1 },
            "scale": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "if": { "properties": { "type": { "const": "multiValue" } } },
      "then": { "required": ["element"] },
      "else": { "not": { "required": ["element"] } }
    },
    "default": {
      "type": "object",
      "required": ["access", "kind"],
      "properties": {
        "access": { "type": "string", "description": "The DefaultValue as Access stores it." },
        "kind": { "enum": ["literal", "null", "currentTimestamp", "currentDate", "currentTime", "newGuid", "expression", "unsupported"] },
        "value": { "type": ["boolean", "number", "string"], "description": "kind literal: the literal in its own JSON form, not converted to the column's type (a date literal as a date-time string)." },
        "reason": { "type": "string", "description": "kind unsupported: why the expression wasn't translated." }
      },
      "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "kind": { "const": "literal" } } }, "then": { "required": ["value"] }, "else": { "not": { "required": ["value"] } } },
        { "if": { "properties": { "kind": { "const": "unsupported" } } }, "then": { "required": ["reason"] }, "else": { "not": { "required": ["reason"] } } }
      ]
    },
    "validationRule": {
      "type": "object",
      "required": ["access", "validationText"],
      "properties": {
        "access": { "type": "string" },
        "validationText": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "index": {
      "type": "object",
      "required": ["name", "columns", "unique", "ignoreNulls", "required", "accessNames"],
      "properties": {
        "name": { "type": "string" },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "order"],
            "properties": { "name": { "type": "string" }, "order": { "enum": ["asc", "desc"] } },
            "additionalProperties": false
          }
        },
        "unique": { "type": "boolean" },
        "ignoreNulls": { "type": "boolean", "description": "Access leaves rows whose key columns are all NULL out of the index." },
        "required": { "type": "boolean" },
        "accessNames": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Every Access index merged into this one, its own name first." }
      },
      "additionalProperties": false
    },
    "linkedTable": {
      "type": "object",
      "required": ["name", "database", "remoteTable", "odbc"],
      "properties": {
        "name": { "type": "string" },
        "database": { "type": "string", "description": "The linked database's path as Access stored it, or the ODBC connection string." },
        "remoteTable": { "type": "string" },
        "odbc": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "required": ["name", "parent", "child", "enforced", "onUpdate", "onDelete", "oneToOne", "join"],
      "properties": {
        "name": { "type": "string" },
        "parent": { "$ref": "#/$defs/relationshipSide" },
        "child": { "$ref": "#/$defs/relationshipSide" },
        "enforced": { "type": "boolean", "description": "Access enforces referential integrity. Without it the child may hold values the parent doesn't." },
        "onUpdate": { "enum": ["noAction", "cascade", "setNull"] },
        "onDelete": { "enum": ["noAction", "cascade", "setNull"] },
        "oneToOne": { "type": "boolean" },
        "join": { "enum": ["inner", "leftOuter", "rightOuter"], "description": "The join type Access's query designer uses for the relationship." }
      },
      "additionalProperties": false
    },
    "relationshipSide": {
      "type": "object",
      "required": ["table", "columns"],
      "properties": {
        "table": { "type": "string" },
        "columns": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "value": {
      "description": "One value. Its spelling follows the column's type: see the format documentation.",
      "oneOf": [
        { "type": ["null", "boolean", "number", "string"] },
        { "$ref": "#/$defs/hyperlink" },
        { "$ref": "#/$defs/binaryFile" },
        { "$ref": "#/$defs/binarySize" },
        { "$ref": "#/$defs/oleObject" },
        {
          "type": "array",
          "description": "An attachments, multiValue or versionHistory cell: its values in Access's order.",
          "items": {
            "oneOf": [
              { "type": ["null", "boolean", "number", "string"] },
              { "$ref": "#/$defs/attachment" },
              { "$ref": "#/$defs/version" }
            ]
          }
        }
      ]
    },
    "base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$" },
    "binaryFile": {
      "type": "object",
      "description": "encoding.binary files: the file holding the bytes, relative to the output's directory with forward slashes, and its size.",
      "required": ["file", "size"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "size": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "binarySize": {
      "type": "object",
      "description": "encoding.binary omit: the bytes are left out; their count stays. An empty value is 0, a NULL value null.",
      "required": ["size"],
      "properties": { "size": { "type": "integer", "minimum": 0 } },
      "additionalProperties": false
    },
    "bytes": {
      "oneOf": [{ "$ref": "#/$defs/base64" }, { "$ref": "#/$defs/binaryFile" }, { "$ref": "#/$defs/binarySize" }]
    },
    "oleObject": {
      "type": "object",
      "description": "encoding.ole extracted: the raw bytes and what decoding them found. kind is null when the value couldn't be decoded.",
      "required": ["raw", "kind", "name", "mime", "content"],
      "properties": {
        "raw": { "$ref": "#/$defs/bytes" },
        "kind": { "enum": ["package", "embedded", "link", "compound", "raw", null] },
        "name": { "type": ["string", "null"], "description": "package: the file name; embedded and compound: the OLE class; link: the link path; raw: null." },
        "mime": {
          "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-z]+/[a-z0-9.+-]+$" }],
          "description": "The content's type from its bytes' magic number only, never from a name; null when not recognized. raw: sniffed from the raw bytes."
        },
        "content": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/bytes" }],
          "description": "package: the embedded file; embedded and compound: the object's bytes; link and raw: null."
        }
      },
      "additionalProperties": false
    },
    "attachment": {
      "type": "object",
      "description": "One file of an attachments cell. Its bytes are data (base64), file (a path) or absent (encoding.binary omit); size is always there.",
      "required": ["fileName", "fileType", "size", "url", "timestamp", "flags"],
      "properties": {
        "fileName": { "type": ["string", "null"] },
        "fileType": { "type": ["string", "null"] },
        "size": { "type": ["integer", "null"], "minimum": 0 },
        "data": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/base64" }] },
        "file": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] },
        "timestamp": { "type": ["string", "null"] },
        "flags": { "type": ["integer", "null"] }
      },
      "additionalProperties": false,
      "not": { "required": ["data", "file"] }
    },
    "version": {
      "type": "object",
      "description": "One entry of a versionHistory cell (--include-version-history).",
      "required": ["value", "modified"],
      "properties": {
        "value": { "type": ["string", "null"] },
        "modified": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "hyperlink": {
      "type": "object",
      "description": "encoding.hyperlinks object: the parts of display#address#subaddress#screentip; a missing or empty part is null.",
      "required": ["display", "address", "subAddress", "screenTip"],
      "properties": {
        "display": { "type": ["string", "null"] },
        "address": { "type": ["string", "null"] },
        "subAddress": { "type": ["string", "null"] },
        "screenTip": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "objectRow": { "type": "object", "additionalProperties": { "$ref": "#/$defs/value" } },
    "arrayRow": { "type": "array", "items": { "$ref": "#/$defs/value" } }
  }
}
