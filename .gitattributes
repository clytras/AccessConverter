# LF everywhere (matches .editorconfig), so golden files and mvnw are byte-identical on every OS
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Golden files are compared byte for byte and hold data verbatim, a CR inside an Access memo included, so
# Git must not touch their line endings
/src/test/resources/golden/** -text

*.accdb binary
*.mdb binary
*.sqlite3 binary
*.jar binary
*.zip binary
